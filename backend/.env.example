# Local: ARAK_DEVELOPMENT=1 ; NEVER ENABLE IT ON INTERNET
# Production must set a unique random secret, allowed hosts and HTTPS reverse proxy.
ARAK_ALLOWED_HOSTS=shop.example.com
ARAK_SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET_MINIMUM_50_CHARS
ARAK_DB_PATH=/path/to/persistent/store.sqlite3
# ARAK_TRUST_LOCAL_PROXY=1  # ONLY when reverse proxy correctly sanitizes X-Forwarded-Proto

# Optional: override the existing manager email or media directory.
# ARAK_MANAGER_EMAIL=owner@example.com
# ARAK_MEDIA_ROOT=/var/lib/arak-kala/media
