{$ARAK_SITE_ADDRESS} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy same-origin
        -Server
    }
    handle_path /static/* {
        root * /srv/static
        file_server
    }
    @productMedia path_regexp productMedia ^/uploads/products/[0-9a-f]{32}\.jpg$
    handle @productMedia {
        uri strip_prefix /uploads
        root * /srv/media
        header Cache-Control "public, max-age=86400"
        file_server
    }
    handle /uploads/* {
        respond 404
    }
    handle {
        reverse_proxy app:8000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
