# Copy to .env outside Git and chmod 600. No actual credentials here.
ARAK_SITE_ADDRESS=shop.example.invalid
ARAK_ALLOWED_HOSTS=shop.example.invalid
ARAK_SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET_MINIMUM_50_CHARS
ARAK_PUBLIC_ORIGIN=https://shop.example.invalid
ARAK_MAIL_ENABLED=0
# Set the manager email only if explicitly authorized; existing default retained.
# SMTP is optional; enable only after provider and TLS delivery are verified.
# ARAK_SMTP_HOST=
# ARAK_SMTP_PORT=587
# ARAK_SMTP_USER=
# ARAK_SMTP_PASSWORD=
# ARAK_FROM_EMAIL=
# ARAK_SMTP_TLS=1
# ARAK_SMTP_SSL=0
